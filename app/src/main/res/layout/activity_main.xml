<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_desplay_count"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/yellow"
        android:gravity="center"
        android:text="@string/count_value"
        android:textColor="@color/blue"
        android:textSize="120sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_toast"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_toast"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:layout_marginStart="10dp"
        android:backgroundTint="@color/blue"
        android:onClick="show_toast"
        android:text="@string/button1"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/button_zero"
        app:layout_constraintEnd_toStartOf="@id/text_desplay_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_desplay_count"
        app:layout_constraintVertical_chainStyle="spread" />

    <Button
        android:id="@+id/button_zero"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:backgroundTint="@color/gray"
        android:onClick="show_zero"
        android:text="@string/button_zero"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/button_count"
        app:layout_constraintEnd_toStartOf="@id/text_desplay_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_toast" />

    <Button
        android:id="@+id/button_count"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:backgroundTint="@color/blue"
        android:onClick="increase_count"
        android:text="@string/button2"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/text_desplay_count"
        app:layout_constraintEnd_toStartOf="@id/text_desplay_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_zero" />

</androidx.constraintlayout.widget.ConstraintLayout>